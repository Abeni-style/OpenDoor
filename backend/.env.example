# FRONTEND: place only the Supabase project URL and anon/publishable key in backend-config.js.
# Server-only secrets: add with `supabase secrets set` or Dashboard > Edge Functions > Secrets.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
OPENAI_API_KEY=SERVER_ONLY_NEVER_COMMIT
OPENAI_MODEL=MODEL_AVAILABLE_IN_YOUR_API_ACCOUNT
RATE_LIMIT_PEPPER=GENERATE_A_LONG_RANDOM_SECRET
FRONTEND_ORIGIN=https://YOUR_PUBLIC_SITE
STRIPE_SECRET_KEY=SERVER_ONLY_NEVER_COMMIT
STRIPE_PREMIUM_PRICE_ID=price_xxx
STRIPE_WEBHOOK_SECRET=SERVER_ONLY_NEVER_COMMIT
OPEN_DOOR_SYNC_SECRET=GENERATE_A_LONG_RANDOM_SECRET

# Telegram opportunity intake: server-only secrets; never put these in frontend files.
TELEGRAM_BOT_TOKEN=SERVER_ONLY_NEVER_COMMIT
TELEGRAM_WEBHOOK_SECRET=GENERATE_A_RANDOM_WEBHOOK_SECRET
TELEGRAM_ALLOWED_CHAT_IDS=comma_separated_maintainer_chat_ids
